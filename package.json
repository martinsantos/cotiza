{
  "name": "cotizar-cli",
  "version": "1.0.0",
  "description": "CLI tool for generating competitive bids for Argentine government tenders",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "cotizAR": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:api": "node dist/api/server.js",
    "dev": "tsx src/index.ts",
    "dev:api": "tsx src/api/server.ts",
    "api": "tsx src/api/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "cli",
    "tender",
    "bid",
    "licitacion",
    "argentina",
    "cotizacion"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "better-sqlite3": "^12.6.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "flexsearch": "^0.7.31",
    "handlebars": "^4.7.8",
    "inquirer": "^9.2.12",
    "pdfkit": "^0.14.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.5",
    "@types/pdfkit": "^0.13.3",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
