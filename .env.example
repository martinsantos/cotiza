# cotizAR CLI Environment Variables

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0

# Base path for subpath deployment (e.g. /cotizar for licitometro.ar/cotizar)
BASE_PATH=/cotizar

# Database (SQLite - persistente)
DB_PATH=./data/cotizar.db

# LICITOMETRO.AR Integration
LICITOMETRO_API_URL=https://licitometro.ar/api
LICITOMETRO_API_KEY=

# Market Data APIs (gratis, sin API key)
DOLAR_API_URL=https://dolarapi.com/v1
BCRA_API_URL=https://api.bcra.gob.ar

# Company Configuration
COMPANY_NAME=Mi Empresa SA
COMPANY_TAX_ID=30-12345678-9

# Output Directory
OUTPUT_DIR=./bids

# Logging
LOG_LEVEL=info

# Scheduler (sync automatico)
SYNC_INTERVAL_HOURS=6
MARKET_UPDATE_INTERVAL_HOURS=4
