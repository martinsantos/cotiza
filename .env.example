# cotizAR CLI Environment Variables

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0

# Base path for subpath deployment (e.g. /cotizar for licitometro.ar/cotizar)
BASE_PATH=/cotizar

# LICITOMETRO.AR Integration
LICITOMETRO_API_URL=https://licitometro.ar/api
LICITOMETRO_API_KEY=

# Market Data APIs
BCRA_API_URL=https://api.bcra.gob.ar
INDEC_API_URL=https://api.indec.gob.ar

# Company Configuration
COMPANY_NAME=Mi Empresa SA
COMPANY_TAX_ID=30-12345678-9

# Output Directory
OUTPUT_DIR=./bids

# Logging
LOG_LEVEL=info
